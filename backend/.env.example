# Copy to backend/.env and adjust. Settings use the GATEWAY_ prefix; nested via "__".
# Secrets (signing keys, IdP client secret) are NEVER set here — they come from the
# secrets manager (ADR-0011). This file holds non-secret local dev configuration only.

GATEWAY_ENVIRONMENT=development
GATEWAY_DEPLOYMENT_MODE=saas
GATEWAY_LOG_LEVEL=info
GATEWAY_LOG_JSON=false            # human-readable console logs for local dev

# Database (matches docker-compose.dev.yml). SQLite is used automatically in tests.
#
# Runtime/DDL split (ADR-0014): the application connects as the least-privilege `app_rw`
# role (NOSUPERUSER, NOBYPASSRLS) so PostgreSQL RLS actually enforces tenant isolation.
# A superuser/BYPASSRLS connection would silently defeat isolation (NFR-SEC07).
GATEWAY_DATABASE__URL=postgresql+asyncpg://app_rw:app_rw@localhost:5432/gateway
GATEWAY_DATABASE__POOL_SIZE=10
GATEWAY_DATABASE__ECHO=false

# Migrations run as the schema OWNER (the migrator), NOT as app_rw. In dev this is the
# superuser created by docker-compose; in prod it is a dedicated migrator principal.
#
# NOT an application setting. `Settings` owns no `migration_database` field and rejects
# unknown GATEWAY_* keys (extra="forbid"), so an ACTIVE line here would make every
# `load_settings()` fail the moment this file is copied to .env. It is a shell/OS variable
# read by the migration and validation tooling only - export it, do not set it here:
#
#   export GATEWAY_MIGRATION_DATABASE__URL=postgresql+asyncpg://gateway:gateway@localhost:5432/gateway
#
# Same reasoning as GATEWAY_TEST_REDIS_URL below: tooling variables stay commented.

# --- Phase 5 M3: ingress protection (FR-064/065) ---------------------------------------
# Default platform limits, applied per tenant. The per-organization/project/key
# rate_limit_policy hierarchy in API_Rate_Limiting.md §2 needs an admin API that does not
# exist yet, so every tenant currently gets its own bucket of this one size.
GATEWAY_INGRESS__REQUESTS_PER_SECOND=10
GATEWAY_INGRESS__BURST=20
GATEWAY_INGRESS__MAX_REQUEST_BYTES=1048576

# --- Phase 5 M4: shared runtime state (ADR-0021) ---------------------------------------
# OPTIONAL. Unset means the single-node profile: the rate limiter stays in process and each
# replica enforces the limit independently. Set it to share one bucket across replicas
# (matches docker-compose.dev.yml).
#
# Gate 2 requires this (or GATEWAY_TEST_REDIS_URL) so the shared-state integration tests
# cannot silently skip.
#
# The credential belongs IN the url; only the masked form is ever logged.
GATEWAY_REDIS__URL=redis://localhost:6379/0
# Namespaces every key, so two deployments pointed at one Redis cannot share buckets.
GATEWAY_REDIS__KEY_PREFIX=gateway
GATEWAY_REDIS__TIMEOUT_SECONDS=0.25
